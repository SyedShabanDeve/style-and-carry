# Copy to .env and change the secrets before going live.
PORT=4000
NODE_ENV=development

# Sign the admin tokens. Any long random string. Changing it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string

# How long an admin stays signed in before the session expires.
SESSION_MINUTES=10

# First admin account, used by `npm run seed` when no user exists yet.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Leave blank to allow any origin. In production list your real site:
# CORS_ORIGIN=https://styleandcarry.com,https://www.styleandcarry.com
CORS_ORIGIN=

# The shop address used in emailed links, e.g. https://styleandcarry.com
# Leave empty to use the address the dashboard is opened on.
APP_URL=

# Optional: email (SMTP). Can also be set in Dashboard -> Team -> Email settings.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-letter-app-password
# MAIL_FROM=you@gmail.com
